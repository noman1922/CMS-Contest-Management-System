# ==============================================================
# CMS - Contest Management System Configuration Example
# ==============================================================
# The platform runs entirely client-side using HTML5 LocalStorage
# for instant, zero-setup static deployment (e.g. GitHub Pages).
#
# If integrating an optional backend REST/GraphQL API or database
# in production, configure the variables below:

# Application
VITE_APP_TITLE="ACI Career Edge Program - CMS"
PORT=8080

# Backend API Configuration (Optional / Production Integration)
API_BASE_URL=https://api.example.com/v1
DATABASE_URL=
JWT_SECRET=your_jwt_secret_placeholder

# Storage & CDN (Optional)
STORAGE_BUCKET_URL=https://storage.example.com
